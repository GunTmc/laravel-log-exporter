# Salin ke /etc/default/alogreport dan sesuaikan. Dibaca oleh deploy/alogreport-daily.sh.
# Izin yang disarankan: chmod 640 /etc/default/alogreport

# Wajib: folder log Laravel
LOG_DIR=/var/www/portal-seemedik-api/storage/logs

# Folder keluaran laporan (jangan di dalam folder yang disajikan web server)
REPORT_DIR=/var/reports/laravel

# Awalan nama file log (laravel-YYYY-MM-DD.log)
LOG_PREFIX=laravel

# yesterday (disarankan, dijalankan sesudah tengah malam) atau tanggal tetap YYYY-MM-DD
REPORT_DATE=yesterday

# Level minimum: debug|info|notice|warning|error|critical|alert|emergency
LEVEL=error

# 1 = samarkan email, NIK, nomor HP, token (sangat disarankan untuk data medis)
MASK=1

# Izin file laporan. 640 bila grup tertentu perlu membaca.
REPORT_MODE=600

# Hapus laporan lebih tua dari sekian hari (0 = jangan hapus)
RETENTION_DAYS=30

# Executable Bun: nama di PATH atau path lengkap. Unit systemd memakai ProtectHome=yes,
# jadi pasang Bun di lokasi yang bisa dibaca user alogreport (mis. /usr/local/bin/bun), bukan di ~/.bun.
RUNTIME=bun

# Opsi tambahan untuk alogreport, dipisah spasi
ALOGREPORT_ARGS=
